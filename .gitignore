/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Local secrets and credentials
.env
.env.*
!.env.example
/supabase/.temp/
/tests/auth-local/supabase/.temp/
/tests/auth-local/supabase/.branches/
/src/environments/environment.auth-local.ts
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx

# System files
.DS_Store
Thumbs.db

# Pruebas e2e de accesibilidad
/test-results
/playwright-report

# Estado de interfaz de Obsidian (paneles y ficheros abiertos), propio de cada equipo
/docs/.obsidian/workspace.json
/docs/.obsidian/workspace-mobile.json

# Adjuntos locales de agentes remotos (capturas con datos personales)
/.codex-remote-attachments/
